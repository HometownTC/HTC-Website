---
import Layout from '../layouts/Layout.astro';
import App from '../App';
import { loadPublishedBlogPosts } from '../utils/loadPublishedPosts';
import { CATEGORY_ARCHIVES } from '../data/blog-categories';
import { RESOURCE_LIBRARY_ITEMS, getResourceBySlug } from '../data/resourceLibraryData';
import { LOCATION_PAGES } from '../data/locationData';

export async function getStaticPaths() {
  const routes = [
    'es',
    'es/precios',
    'es/enviar-transaccion',
    'how-htc-works',
    'how-it-works',
    'why-htc',
    'pricing',
    'listing-coordination',
    'contract-to-close-services',
    'contract-to-close',
    'transaction-coordination',
    'transaction-coordinator-for-realtors',
    'agent-business-calculator',
    'about',
    'team',
    'meet-the-tribe',
    'who-we-support',
    'miami-transaction-coordinator',
    'miami-dade-transaction-coordinator',
    'broward-transaction-coordinator',
    'south-florida-transaction-coordinator',
    'faq',
    'book',
    'submit-deal',
    'reviews',
    'resources',
    'tcworkshop',
    'resources/free-guides-downloads',
    'resources/free-guides-downloads/condo-coop-hoa-guide'
  ];

  const locationRoutes = Object.keys(LOCATION_PAGES);
  const publishedPosts = await loadPublishedBlogPosts();
  const blogRoutes = publishedPosts.map(post => `resources/${post.slug}`);
  const categoryRoutes = Object.keys(CATEGORY_ARCHIVES).map(slug => `resources/${slug}`);

  // Dynamic Resource Library routes for each individual resource
  const resourceRoutes = RESOURCE_LIBRARY_ITEMS.map(
    item => `resources/free-guides-downloads/${item.slug}`
  );

  const allSlugs = [...routes, ...locationRoutes, ...blogRoutes, ...categoryRoutes, ...resourceRoutes];

  return allSlugs.map(slug => {
    let title = "Hometown TC | Boutique Real Estate Support Agency for Florida Realtors";
    let description = "Boutique real estate support for Florida Realtors — from Listing Launch to Contract-to-Close and Post-Close. South Florida-founded, serving statewide.";
    let language = "en";
    let canonicalUrl: string | undefined = undefined;
    let alternateUrls: { lang: string; url: string }[] | undefined = undefined;

    if (LOCATION_PAGES[slug]) {
      const loc = LOCATION_PAGES[slug];
      title = loc.metaTitle;
      description = loc.metaDescription;
    } else if (slug === 'es') {
      title = "Hometown TC en Español | Coordinación de Transacciones para Agentes de Bienes Raíces en Florida";
      description = "Cierres sin fricciones. Punto. Coordinación de transacciones boutique y bilingüe para Realtors en Florida. De Contrato a Cierre con total cumplimiento y tranquilidad.";
      language = "es";
    } else if (slug === 'es/precios') {
      title = "Precios y Planes de Coordinación de Transacciones en Florida | Hometown TC";
      description = "Precios transparentes y sin sorpresas para agentes en Florida. Contrato a Cierre desde $375 pagado al cierre, Lanzamiento de Listados y soporte bilingüe.";
      language = "es";
    } else if (slug === 'es/enviar-transaccion') {
      title = "Enviar una Nueva Transacción | Hometown TC Florida";
      description = "Envíe los detalles de su transacción para Lanzamiento de Listado, Contrato a Cierre o Cumplimiento con su Broker en Florida. Procesamiento rápido el mismo día.";
      language = "es";
    } else if (slug === 'resources/free-guides-downloads' || slug === 'free-guides-downloads' || slug === 'resources/guides' || slug === 'guides') {
      title = "Free Agent Toolkit for Florida Realtors | Hometown TC";
      description = "Free tools for Florida agents from Hometown Transaction Coordinators: a FAR/BAR timeline calculator, client email templates, Canva templates and a condo, co-op and HOA resource guide.";
    } else if (slug === 'resources/free-guides-downloads/condo-coop-hoa-guide') {
      title = "Florida Condo, Co-op & HOA Resource Guide for Agents | Hometown TC";
      description = "Florida condo, co-op and HOA statutes, Miami-Dade and Broward association rules, DBPR forms, the Condominium Ombudsman and document request scripts for Realtors.";
    } else if (slug.startsWith('resources/free-guides-downloads/') || slug.startsWith('free-guides-downloads/')) {
      const resourceSlug = slug.split('/').pop() || '';
      const matchedResource = getResourceBySlug(resourceSlug);
      if (matchedResource) {
        title = matchedResource.seoTitle || `${matchedResource.title} | Hometown TC`;
        description = matchedResource.seoDescription || matchedResource.shortDescription;
      }
    } else if (slug.startsWith('resources/')) {
      const subSlug = slug.replace('resources/', '');
      if (CATEGORY_ARCHIVES[subSlug]) {
        title = CATEGORY_ARCHIVES[subSlug].metaTitle;
        description = CATEGORY_ARCHIVES[subSlug].metaDescription;
      } else {
        const matchedPost = publishedPosts.find(p => p.slug === subSlug);
        if (matchedPost) {
          title = `${matchedPost.title} | The Hometown Brief • HTC`;
          description = matchedPost.description;
          language = matchedPost.language || 'en';
          canonicalUrl = matchedPost.canonical;

          const counterpart = publishedPosts.find(
            p =>
              (matchedPost.translationOf && p.slug === matchedPost.translationOf) ||
              p.translationOf === matchedPost.slug
          );
          if (counterpart) {
            const enPost = matchedPost.language === 'en' ? matchedPost : counterpart;
            alternateUrls = [
              { lang: matchedPost.language, url: matchedPost.canonical },
              { lang: counterpart.language, url: counterpart.canonical },
              { lang: 'x-default', url: enPost.canonical },
            ];
          }
        }
      }
    }

    return {
      params: { slug },
      props: { title, description, language, canonicalUrl, alternateUrls, publishedPosts }
    };
  });
}

const { title, description, language = "en", canonicalUrl, alternateUrls, publishedPosts = [] } = Astro.props;
const currentPath = `/${Astro.params.slug}/`;
---

<Layout title={title} description={description} language={language} canonicalUrl={canonicalUrl} alternateUrls={alternateUrls}>
  <App client:idle initialPath={currentPath} initialLanguage={language} publishedPosts={publishedPosts} />
</Layout>

