---
import Layout from '../layouts/Layout.astro';
import App from '../App';
import { loadPublishedBlogPosts } from '../utils/loadPublishedPosts';
import { CATEGORY_ARCHIVES } from '../data/blog-categories';
import { RESOURCE_LIBRARY_ITEMS, getResourceBySlug } from '../data/resourceLibraryData';
import { LOCATION_PAGES } from '../data/locationData';
import { PAGE_META } from '../data/pageMeta';
import { buildArticleSchema } from '../utils/articleSchema';

export async function getStaticPaths() {
  const routes = [
    'es',
    'es/precios',
    'es/enviar-transaccion',
    'es/agendar',
    'es/como-funciona',
    'es/por-que-htc',
    'es/michelle',
    'es/equipo',
    'how-htc-works',
    'how-it-works',
    'why-htc',
    'pricing',
    'listing-coordination',
    'contract-to-close-services',
    'contract-to-close',
    'transaction-coordination',
    'transaction-coordinator-for-realtors',
    'agent-business-calculator',
    'about',
    'team',
    'meet-the-tribe',
    'who-we-support',
    'miami-transaction-coordinator',
    'miami-dade-transaction-coordinator',
    'broward-transaction-coordinator',
    'south-florida-transaction-coordinator',
    'faq',
    'book',
    'submit-deal',
    'reviews',
    'resources',
    'tcworkshop',
    'tcworkshop/affiliates',
    'es/tcworkshop/afiliados',
    'lit',
    'es/lit',
    'lamp',
    'es/lamp',
    'lamp/manage',
    'es/lamp/manage',
    'resources/free-guides-downloads',
    'resources/free-guides-downloads/condo-coop-hoa-guide',
    'resources/free-guides-downloads/florida-short-sale-field-guide',
    'resources/free-guides-downloads/short-sale-weekly-follow-up-log'
  ];

  const locationRoutes = Object.keys(LOCATION_PAGES);
  const publishedPosts = await loadPublishedBlogPosts();
  const blogRoutes = publishedPosts.map(post => `resources/${post.slug}`);
  const categoryRoutes = Object.entries(CATEGORY_ARCHIVES)
    .filter(([, cfg]) => !cfg.hideUntilFirstPost || publishedPosts.some(p => p.category === cfg.name))
    .map(([slug]) => `resources/${slug}`);

  // Dynamic Resource Library routes for each individual resource
  const resourceRoutes = RESOURCE_LIBRARY_ITEMS.map(
    item => `resources/free-guides-downloads/${item.slug}`
  );

  const allSlugs = [...routes, ...locationRoutes, ...blogRoutes, ...categoryRoutes, ...resourceRoutes];

  return allSlugs.map(slug => {
    let title = "Hometown TC | Boutique Real Estate Support Agency for Florida Realtors";
    let description = "Boutique real estate support for Florida Realtors — from Listing Launch to Contract-to-Close and Post-Close. South Florida-founded, serving statewide.";
    let language = "en";
    let canonicalUrl: string | undefined = undefined;
    let alternateUrls: { lang: string; url: string }[] | undefined = undefined;
    let ogImage: string | undefined = undefined;
    let ogType: string | undefined = undefined;
    let jsonLd: Record<string, unknown> | undefined = undefined;
    let articleMeta: { publishedTime: string; modifiedTime: string; section: string; author: string } | undefined = undefined;

    if (PAGE_META[slug]) {
      title = PAGE_META[slug].title;
      description = PAGE_META[slug].description;
    } else if (LOCATION_PAGES[slug]) {
      const loc = LOCATION_PAGES[slug];
      title = loc.metaTitle;
      description = loc.metaDescription;
    } else if (slug === 'es') {
      title = "Hometown TC en Español | Agencia Boutique de Apoyo Inmobiliario para Realtors en Florida";
      description = "Apoyo inmobiliario boutique para Realtors en Florida: Lanzamiento de Listados, De Contrato a Cierre y Post-Cierre. Fundada en el Sur de Florida, con servicio en todo el estado.";
      language = "es";
    } else if (slug === 'es/agendar') {
      title = "Agendar Llamada de Compatibilidad | Hometown Transaction Coordinators";
      description = "Una conversación de 15 minutos para conocer lo que necesita y ver si HTC es la opción adecuada para su negocio.";
      language = "es";
    } else if (slug === 'es/como-funciona') {
      title = "Cómo Funciona HTC | Hometown Transaction Coordinators";
      description = "Cómo trabaja HTC con agentes en Florida: llamada de compatibilidad, configuración, envío de expedientes y el Método de Cierre H.O.M.E.";
      language = "es";
    } else if (slug === 'es/por-que-htc') {
      title = "Por Qué HTC | Hometown Transaction Coordinators";
      description = "Por qué Realtors en Florida confían en HTC para listados, contratos y cierres: experiencia, proceso y un equipo bilingüe.";
      language = "es";
    } else if (slug === 'es/michelle') {
      title = "Michelle Martinez | Fundadora de Hometown Transaction Coordinators";
      description = "Michelle Martinez, fundadora y propietaria de Hometown Transaction Coordinators. Al servicio de Realtors desde 1995, con más de 20,000 transacciones procesadas personalmente.";
      language = "es";
    } else if (slug === 'es/equipo') {
      title = "Conozca al Equipo HTC | Transaction Coordinators en Florida";
      description = "Conozca al equipo detrás de Hometown Transaction Coordinators: un Lead TC con experiencia, respaldado por un equipo Hometown dedicado.";
      language = "es";
    } else if (slug === 'es/precios') {
      title = "Precios y Planes de Coordinación de Transacciones en Florida | Hometown TC";
      description = "Precios transparentes y sin sorpresas para agentes en Florida. The Hometown Signature a $495 por lado cerrado, Lanzamiento de Listados y soporte bilingüe.";
      language = "es";
    } else if (slug === 'es/enviar-transaccion') {
      title = "Enviar una Nueva Transacción | Hometown TC Florida";
      description = "Envíe los detalles de su transacción para Lanzamiento de Listado, Contrato a Cierre o Cumplimiento con su Broker en Florida. Procesamiento rápido el mismo día.";
      language = "es";
    } else if (slug === 'tcworkshop') {
      title = "My TC Workshop 2026: Florida Transaction Coordinator Course, English & Spanish | Hometown TC";
      description = "Guardian of the File 2026 by Michelle Martinez. Florida TC training on FAR/BAR contracts, deadlines, documents and compliance, in English or Spanish. Pre-launch price $399.";
    } else if (slug === 'resources/free-guides-downloads' || slug === 'free-guides-downloads' || slug === 'resources/guides' || slug === 'guides') {
      title = "Free Agent Toolkit for Florida Realtors | Hometown TC";
      description = "Free tools for Florida agents from Hometown Transaction Coordinators: a FAR/BAR timeline calculator, client email templates, Canva templates and a condo, co-op and HOA resource guide.";
    } else if (slug === 'resources/free-guides-downloads/condo-coop-hoa-guide') {
      title = "Florida Condo, Co-op & HOA Resource Guide for Agents | Hometown TC";
      description = "Florida condo, co-op and HOA statutes, Miami-Dade and Broward association rules, DBPR forms, the Condominium Ombudsman and document request scripts for Realtors.";
    } else if (slug === 'resources/free-guides-downloads/short-sale-weekly-follow-up-log') {
      title = "Short Sale Weekly Follow-Up Log for Florida Agents (Free PDF) | Hometown TC";
      description = "Free one-page tracker for Florida short sales pending lender approval: five weekly questions and a log for status, missing items and next check. Includes the full Field Guide.";
    } else if (slug === 'resources/free-guides-downloads/florida-short-sale-field-guide') {
      title = "Florida Short Sale Field Guide for Realtors (Free PDF) | Hometown TC";
      description = "Free 15-page guide for Florida agents on short sales pending approval: FHA, VA, Fannie Mae and Freddie Mac rules, a Rider G cheat sheet, checklists and a weekly follow-up log.";
    } else if (slug.startsWith('resources/free-guides-downloads/') || slug.startsWith('free-guides-downloads/')) {
      const resourceSlug = slug.split('/').pop() || '';
      const matchedResource = getResourceBySlug(resourceSlug);
      if (matchedResource) {
        title = matchedResource.seoTitle || `${matchedResource.title} | Hometown TC`;
        description = matchedResource.seoDescription || matchedResource.shortDescription;
      }
    } else if (slug.startsWith('resources/')) {
      const subSlug = slug.replace('resources/', '');
      if (CATEGORY_ARCHIVES[subSlug]) {
        title = CATEGORY_ARCHIVES[subSlug].metaTitle;
        description = CATEGORY_ARCHIVES[subSlug].metaDescription;
      } else {
        const matchedPost = publishedPosts.find(p => p.slug === subSlug);
        if (matchedPost) {
          title = `${matchedPost.title} | The Hometown Brief • HTC`;
          description = matchedPost.description;
          language = matchedPost.language || 'en';
          canonicalUrl = matchedPost.canonical;
          if (matchedPost.heroImage) ogImage = `https://hometowntc.com${matchedPost.heroImage}`;
          ogType = 'article';
          articleMeta = {
            publishedTime: matchedPost.publishDate,
            modifiedTime: matchedPost.modifiedDate,
            section: matchedPost.category,
            author: matchedPost.author,
          };

          const counterpart = publishedPosts.find(
            p =>
              (matchedPost.translationOf && p.slug === matchedPost.translationOf) ||
              p.translationOf === matchedPost.slug
          );
          jsonLd = buildArticleSchema(
            matchedPost,
            matchedPost.translationOf && counterpart ? counterpart.canonical : undefined
          );
          if (counterpart) {
            const enPost = matchedPost.language === 'en' ? matchedPost : counterpart;
            alternateUrls = [
              { lang: matchedPost.language, url: matchedPost.canonical },
              { lang: counterpart.language, url: counterpart.canonical },
              { lang: 'x-default', url: enPost.canonical },
            ];
          }
        }
      }
    }

    // LIT by HTC sales page: English + Spanish versions point at each other.
    if (slug === 'lit' || slug === 'es/lit') {
      if (slug === 'es/lit') {
        language = 'es';
        title = 'LIT de HTC | Plantilla de bot de Grok para agentes de listados';
        description = 'LIT es la plantilla editable de bot de Grok de HTC para agentes de listados: registra visitas, hace las 2 Preguntas por texto y prepara reportes para el agente y el vendedor que tú apruebas. $299 pago único.';
      } else {
        title = 'LIT by HTC | A Grok Bot Template for Listing Agents';
        description = "LIT is HTC's editable Grok bot template for listing agents. It tracks showings and open houses, asks buyer agents the 2 Questions by text, and drafts agent and seller reports for you to approve. $299 one-time.";
      }
      alternateUrls = [
        { lang: 'en', url: 'https://hometowntc.com/lit/' },
        { lang: 'es', url: 'https://hometowntc.com/es/lit/' },
        { lang: 'x-default', url: 'https://hometowntc.com/lit/' }
      ];
    }

    // L.A.M.P. sales page: English + Spanish versions point at each other.
    if (slug === 'lamp/manage' || slug === 'es/lamp/manage') {
      // Private page from L.A.M.P. emails: keep it out of search results.
      title = slug.startsWith('es/') ? 'Administrar L.A.M.P. | Hometown TC' : 'Manage L.A.M.P. | Hometown TC';
      description = 'Manage or cancel L.A.M.P. for your listing.';
      if (slug.startsWith('es/')) language = 'es';
    }
    if (slug === 'lamp' || slug === 'es/lamp') {
      if (slug === 'es/lamp') {
        language = 'es';
        title = 'L.A.M.P. | Reportes semanales para el vendedor | Hometown TC';
        description = 'L.A.M.P. (Listing Activity, Monitoring & Progress): HTC prepara un reporte semanal para el vendedor de tu listado y tú lo apruebas. $99/mes por listado, sin registro.';
      } else {
        title = 'L.A.M.P. Weekly Seller Reports for Listing Agents | Hometown TC';
        description = "L.A.M.P. (Listing Activity, Monitoring & Progress): HTC prepares a weekly seller report for your listing and you approve it. $99/month per listing, no registration.";
      }
      alternateUrls = [
        { lang: 'en', url: 'https://hometowntc.com/lamp/' },
        { lang: 'es', url: 'https://hometowntc.com/es/lamp/' },
        { lang: 'x-default', url: 'https://hometowntc.com/lamp/' }
      ];
    }

    // My TC Workshop affiliate page: English + Spanish versions point at each other.
    if (slug === 'tcworkshop/affiliates' || slug === 'es/tcworkshop/afiliados') {
      if (slug.startsWith('es/')) language = 'es';
      alternateUrls = [
        { lang: 'en', url: 'https://hometowntc.com/tcworkshop/affiliates/' },
        { lang: 'es', url: 'https://hometowntc.com/es/tcworkshop/afiliados/' },
        { lang: 'x-default', url: 'https://hometowntc.com/tcworkshop/affiliates/' }
      ];
    }

    return {
      params: { slug },
      props: { title, description, language, canonicalUrl, alternateUrls, ogImage, ogType, jsonLd, articleMeta, publishedPosts }
    };
  });
}

const { title, description, language = "en", canonicalUrl, alternateUrls, ogImage, ogType, jsonLd, articleMeta, publishedPosts = [] } = Astro.props;
const currentPath = `/${Astro.params.slug}/`;
---

<Layout title={title} description={description} language={language} canonicalUrl={canonicalUrl} alternateUrls={alternateUrls} ogImage={ogImage} ogType={ogType} jsonLd={jsonLd} articleMeta={articleMeta}>
  <App client:idle initialPath={currentPath} initialLanguage={language} publishedPosts={publishedPosts} />
</Layout>

