---
import '../index.css';

interface Props {
  title?: string;
  description?: string;
  language?: string;
  canonicalUrl?: string;
  alternateUrls?: { lang: string; url: string }[];
}

const {
  title = "Hometown TC | Boutique Real Estate Support Agency for Florida Realtors",
  description = "Boutique real estate support for Florida Realtors — from Listing Launch to Contract-to-Close and Post-Close. South Florida-founded, serving statewide.",
  language = "en",
  canonicalUrl,
  alternateUrls
} = Astro.props;

const siteUrl = "https://hometowntc.com";
const rawPath = Astro.url.pathname || '/';
const normalizedPath = rawPath === '/' ? '/' : (rawPath.endsWith('/') ? rawPath : `${rawPath}/`);

// Determine canonical URL
const pageCanonicalUrl = canonicalUrl || `${siteUrl}${normalizedPath}`;

// Determine alternates / hreflang pairs
let alternates = alternateUrls;

if (!alternates) {
  if (normalizedPath === '/' || normalizedPath === '/es/') {
    alternates = [
      { lang: 'en', url: `${siteUrl}/` },
      { lang: 'es', url: `${siteUrl}/es/` },
      { lang: 'x-default', url: `${siteUrl}/` }
    ];
  } else if (normalizedPath === '/pricing/' || normalizedPath === '/es/precios/' || normalizedPath === '/pricing-plans/' || normalizedPath === '/services-and-pricing/') {
    alternates = [
      { lang: 'en', url: `${siteUrl}/pricing/` },
      { lang: 'es', url: `${siteUrl}/es/precios/` },
      { lang: 'x-default', url: `${siteUrl}/pricing/` }
    ];
  } else if (normalizedPath === '/submit-deal/' || normalizedPath === '/es/enviar-transaccion/' || normalizedPath === '/submit/' || normalizedPath === '/deal-intake/') {
    alternates = [
      { lang: 'en', url: `${siteUrl}/submit-deal/` },
      { lang: 'es', url: `${siteUrl}/es/enviar-transaccion/` },
      { lang: 'x-default', url: `${siteUrl}/submit-deal/` }
    ];
  } else {
    alternates = [
      { lang: language, url: pageCanonicalUrl }
    ];
  }
}
---

<!DOCTYPE html>
<html lang={language} class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/jpeg" href="/favicon.jpg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/favicon.jpg" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Canonical and Alternate (Hreflang) Tags -->
    <link rel="canonical" href={pageCanonicalUrl} />
    {alternates.map(alt => (
      <link rel="alternate" hreflang={alt.lang} href={alt.url} />
    ))}

    {import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION && (
      <meta name="google-site-verification" content={import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION} />
    )}
    
    <!-- Google Analytics 4 (GA4) -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){window.dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-HTCPROD2026', { send_page_view: true });
    </script>
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-HTCPROD2026"></script>
    
    <!-- Preload Hero LCP Image -->
    <link rel="preload" as="image" href="/images/michelle_martinez_founder.jpg" fetchpriority="high" />

    <!-- Google Fonts: Fraunces (Display/Headings) and Inter (Body/UI) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..900;1,9..144,300..900&family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap" media="print" onload="this.media='all'" />
    <noscript>
      <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..900;1,9..144,300..900&family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap" />
    </noscript>
  </head>
  <body class="min-h-screen flex flex-col font-sans bg-[#EEEAEB] text-[#3A2E29] antialiased">
    <slot />
  </body>
</html>
